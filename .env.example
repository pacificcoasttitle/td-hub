# ─── Supabase ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# ─── Storage ──────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET=
AWS_PATH=

# ─── SoftPro ─────────────────────────────────────────────────────────────
SOFTPRO_API_URL=
SOFTPRO_TOKEN=
SOFTPRO_USER_ID=
SOFTPRO_CRON_USER_ID=
# Required for inbound SoftPro webhooks (fail-closed if unset). SoftPro/adapter must send either:
#   Authorization: Bearer <SOFTPRO_WEBHOOK_SECRET>
#   X-SoftPro-Signature: sha256=<hmac_sha256_hex(raw_body)>
SOFTPRO_WEBHOOK_SECRET=

# ─── TitlePoint ───────────────────────────────────────────────────────────
TP_USERNAME=
TP_PASSWORD=
TP_BASE_URL=
TP_IMAGE_ENDPOINT=

# ─── Westcor ─────────────────────────────────────────────────────────────
WESTCOR_URL=
WESTCOR_GRANT_TYPE=password
WESTCOR_USERNAME=
WESTCOR_PASSWORD=
WESTCOR_INTEGRATION_PARTNER=

# ─── FNF ──────────────────────────────────────────────────────────────────
FNF_VENDOR_URL=
FNF_USER_URL=
FNF_CPL_URL=
FNF_CLIENT_ID=
FNF_SECRET_KEY=
FNF_ON_BEHALF_OF_USER=
FNF_USERNAME=
FNF_PASSWORD=

# ─── NATIC ────────────────────────────────────────────────────────────────
NATIC_URL=
NATIC_USERNAME=
NATIC_PASSWORD=
NATIC_COMPANY=Pacific Coast Title Company
NATIC_DOCUMENT_ID=

# ─── Doma ─────────────────────────────────────────────────────────────────
DOMA_URL=
DOMA_USERNAME=
DOMA_PASSWORD=
DOMA_COMPANY=Pacific Coast Title Company
DOMA_DOCUMENT_ID=

# ─── SiteX ────────────────────────────────────────────────────────────────
SITEX_BASE_URL=
SITEX_CLIENT_ID=
SITEX_CLIENT_SECRET=
SITEX_FEED_ID=

# ─── Email ────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=
FROM_EMAIL=noreply@pct.com

# ─── SMS (Twilio) ────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Managers Report ──────────────────────────────────────────────────────
MANAGERS_REPORT_API_URL=
MANAGERS_REPORT_API_KEY=

# ─── TESSA (AI) ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Pause automated prelim LLM spend (cron + webhook). Default true. Set false to stop spend.
TESSA_AUTO_ANALYSIS_ENABLED=true
# Pause manual/on-demand analysis (analyze-prelim API). Default true. Director decision.
TESSA_MANUAL_ANALYSIS_ENABLED=true

# ─── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── Jobs ─────────────────────────────────────────────────────────────────
JOB_RUNNER_SECRET=change-me-to-a-real-secret
CRON_SECRET=
