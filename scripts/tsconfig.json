{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "paths": {
      "@/*": ["../src/*"]
    }
  },
  // Scripts import from src, so the app's ambient declarations have to come along.
  "include": ["**/*.ts", "**/*.mts", "../src/types/**/*.d.ts"],
  "exclude": ["node_modules"]
}
